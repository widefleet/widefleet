{
  "name": "@platform/starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "types": "node tools/types.ts",
    "build": "vite build && node tools/prepare.ts",
    "typecheck": "pnpm types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint"
  },
  "dependencies": {
    "better-result": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@sveltejs/adapter-cloudflare": "8.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.4.2"
}
