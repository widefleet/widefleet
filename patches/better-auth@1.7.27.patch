diff --git a/dist/cookies/signed.mjs b/dist/cookies/signed.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4972da7d8d3b37d19abc65cfff00f0ec040a712c
--- /dev/null
+++ b/dist/cookies/signed.mjs
@@ -0,0 +1,26 @@
+//#region src/cookies/signed.ts
+/**
+* Set a signed cookie. With the `keys` option, the signature comes from the
+* configured key operations, and the secret is not used.
+*/
+async function setSignedAuthCookie(ctx, name, value, attributes) {
+	const keys = ctx.context.options.keys;
+	if (!keys) return ctx.setSignedCookie(name, value, ctx.context.secret, attributes);
+	return ctx.setCookie(name, `${value}.${await keys.sign(value)}`, attributes);
+}
+/**
+* Read a signed cookie: its value, `null` when it is missing or malformed, or
+* `false` when its signature is invalid, as `getSignedCookie` returns.
+*/
+async function getSignedAuthCookie(ctx, name) {
+	const keys = ctx.context.options.keys;
+	if (!keys) return ctx.getSignedCookie(name, ctx.context.secret);
+	const cookie = ctx.getCookie(name);
+	if (!cookie) return null;
+	const separator = cookie.lastIndexOf(".");
+	if (separator < 1) return null;
+	const value = cookie.substring(0, separator);
+	return await keys.verify(value, cookie.substring(separator + 1)) ? value : false;
+}
+//#endregion
+export { getSignedAuthCookie, setSignedAuthCookie };
