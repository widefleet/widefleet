--- a/src/analytics/posthog.ts
+++ b/src/analytics/posthog.ts
@@ -87,10 +87,48 @@ export const posthogHead = (options: PosthogOptions): HeadScript[] => {
   const { host, key, ...init } = options;
   const initOptions = { api_host: host ?? POSTHOG_DEFAULT_HOST, ...init };
   const pageviews = capturesNavigations(init) ? POSTHOG_SPA_PAGEVIEWS : "";
+  const managesConsent =
+    init.cookieless_mode === "on_reject" && init.opt_out_capturing_by_default === true;
+  // This mode starts with cookieless pageviews and lets the SDK own the
+  // transition to cookies. Other providers still wait for Blume's consent.
+  const initialize = managesConsent
+    ? `(() => {
+        const consent = window.blumeConsent;
+        const options = ${inlineJson(initOptions)};
+        if (consent) {
+          const autocapture = options.autocapture ?? true;
+          const disablePersistence = options.disable_persistence ?? false;
+          options.autocapture = consent.analytics === true ? autocapture : false;
+          options.disable_persistence = consent.analytics !== true || disablePersistence;
+          options.before_send = (event) => {
+            if (consent.analytics === true) return event;
+            return event.event === "$pageview" && event.properties?.$cookieless_mode === true ? event : null;
+          };
+          options.loaded = (sdk) => {
+            const sync = () => {
+              const accepted = consent.analytics === true;
+              sdk.set_config({
+                autocapture: accepted ? autocapture : false,
+                disable_persistence: !accepted || disablePersistence,
+              });
+              const status = sdk.get_explicit_consent_status();
+              if (accepted && status !== "granted") {
+                sdk.opt_in_capturing({ captureEventName: false });
+              } else if (!accepted && status === "granted") {
+                sdk.opt_out_capturing();
+              }
+            };
+            window.addEventListener("blume:consent", sync);
+            sync();
+          };
+        }
+        posthog.init(${inlineJson(key)}, options);
+      })();`
+    : `posthog.init(${inlineJson(key)},${inlineJson(initOptions)});`;
   return [
     {
-      attributes: {},
-      content: `${POSTHOG_LOADER}posthog.init(${inlineJson(key)},${inlineJson(initOptions)});${pageviews}`,
+      attributes: managesConsent ? { "data-blume-posthog-consent": "cookieless" } : {},
+      content: `${POSTHOG_LOADER}${initialize}${pageviews}`,
     },
   ];
 };
