    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.4",
    "@widefleet/service-docs": "workspace:*",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
