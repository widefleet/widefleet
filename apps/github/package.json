{
  "name": "@widefleet/github",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./wrangler.jsonc": "./wrangler.jsonc"
  },
  "scripts": {
