    "@google-cloud/storage": "8.2.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@orpc/openapi": "1.15.4",
    "@orpc/server": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@platform/app-runtime": "workspace:*",
    "@platform/contracts": "workspace:*",
    "better-auth": "1.7.7",
    "better-result": "3.0.1",
    "blake3-wasm": "2.1.5",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.10",
    "pg": "8.23.1",
    "posthog-node": "5.55.0",
    "zod": "4.6.5"
