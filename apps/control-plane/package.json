{
  "name": "@platform/control-plane",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "build",
    "migrations",
    "src",
    "tools"
  ],
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*.ts",
    "#server/*": "./src/lib/server/*.ts",
    "#shadcn/*": "./src/lib/*"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "initialize": "node tools/initialize.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm --filter @platform/app-runtime build && vite build && node tools/reporting-maps.ts",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
