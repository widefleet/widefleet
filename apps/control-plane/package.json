    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/svelte-table": "9.2.6",
    "@types/pg": "8.23.1",
    "bits-ui": "2.19.5",
    "cn": "0.3.3",
    "emulate": "0.12.1",
    "layerchart": "2.5.2",
    "mode-watcher": "1.1.0",
    "shadcn-svelte": "1.7.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "svelte-sonner": "1.2.1",
    "tailwind-variants": "3.3.1",
