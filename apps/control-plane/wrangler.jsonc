{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "widefleet-control-plane",
  "main": "dist/cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "dist/cloudflare/public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Match Better Auth's default and plugin policies: requests per seconds.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT_100_10",
      "namespace_id": "61001",
      "simple": { "limit": 100, "period": 10 },
    },
    {
      "name": "AUTH_RATE_LIMIT_3_10",
      "namespace_id": "61002",
      "simple": { "limit": 3, "period": 10 },
    },
    {
      "name": "AUTH_RATE_LIMIT_3_60",
      "namespace_id": "61003",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT_20_60",
      "namespace_id": "61004",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT_30_60",
      "namespace_id": "61005",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT_100_60",
      "namespace_id": "61006",
      "simple": { "limit": 100, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT_5_60",
      "namespace_id": "61007",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMIT_60_60",
      "namespace_id": "61008",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "workflows": [
    {
      "binding": "APP_OPERATIONS",
      "name": "widefleet-app-operations",
      "class_name": "AppOperationWorkflow",
    },
    {
      "binding": "DEPLOYMENTS",
      "name": "widefleet-deployments",
      "class_name": "DeploymentWorkflow",
    },
  ],
  "services": [
    {
      "binding": "APP_RUNTIME",
      "service": "widefleet-app-runtime",
      "entrypoint": "RuntimeManagement",
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "APP_RUNTIME_NAME": "widefleet-app-runtime",
    "CLOUDFLARE_ACCOUNT_ID": "00000000000000000000000000000000",
    "PLATFORM_URL": "https://platform.example.com",
    "APP_DOMAIN": "apps.example.com",
    "PLATFORM_USAGE_REPORTING": "false",
    "PLATFORM_CRASH_REPORTING": "false",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Bind an installation-specific Hyperdrive configuration with query caching disabled.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://platform_test:local-test-only@127.0.0.1:25432/platform_test",
    },
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "widefleet-artifacts" }],
}
