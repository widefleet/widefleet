# Replace all placeholders. This file does not provision PostgreSQL, S3 or Entra.
DATABASE_URL=postgres://platform:CHANGE_ME@127.0.0.1:5432/platform
PLATFORM_URL=http://localhost:5173
APP_DOMAIN=apps.example.test
# Azure/GCS configuration: see https://widefleet.com/docs/self-hosting/storage. The default remains S3.
ARTIFACT_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=platform-artifacts
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Writable local state for generated keys. Configure SSO in the browser.
PLATFORM_STATE_DIRECTORY=.local/platform
PLATFORM_AUTH_DIRECTORY=.local/platform/auth
BODY_SIZE_LIMIT=32M
# Built Node server only. Match PLATFORM_URL to the externally visible origin.
HOST=127.0.0.1
PORT=5173
# Enable only behind a trusted proxy that overwrites this header:
# PROTOCOL_HEADER=x-forwarded-proto
