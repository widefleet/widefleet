# Replace all placeholders. This file does not provision PostgreSQL, S3 or Entra.
DATABASE_URL=postgres://platform:CHANGE_ME@127.0.0.1:5432/platform
PLATFORM_URL=http://localhost:5173
APP_DOMAIN=apps.example.test
# Explicit operator mode: print sign-in codes in the server log. Use email with a mail transport.
LOGIN_CODE_DELIVERY=console
# Optional personal-account sign-in. Configure both values for each provider.
# Redirects: PLATFORM_URL/api/auth/callback/widefleet-google and /api/auth/callback/widefleet-microsoft.
# Microsoft app registration: organizational directories and personal Microsoft accounts.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Azure/GCS configuration: see https://widefleet.com/docs/self-hosting/storage. The default remains S3.
ARTIFACT_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=platform-artifacts
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Writable local state for generated keys. Configure SSO in the browser.
PLATFORM_STATE_DIRECTORY=.local/platform
PLATFORM_RUNTIME_DIRECTORY=.local/platform/runtime
BODY_SIZE_LIMIT=32M
# Built Node server only. Match PLATFORM_URL to the externally visible origin.
HOST=127.0.0.1
PORT=5173
# Enable only behind a trusted proxy that overwrites this header:
# PROTOCOL_HEADER=x-forwarded-proto

# Optional product analytics. No browser or server analytics without both values.
# Use a public project ingestion token, never a personal/administrative API key.
# POSTHOG_PROJECT_TOKEN=phc_example
# POSTHOG_ORIGIN=https://control.example.com
# POSTHOG_PROXY_PATH=/analytics
# POSTHOG_SESSION_REPLAY=false
# POSTHOG_SCOPE=installation
