# Optional build-time overrides for the configured public PostHog project token.
# An explicitly empty key builds the docs without analytics or a consent banner.
DOCS_POSTHOG_KEY=

# Optional website URL for local production previews. The dev script defaults
# to http://localhost:5178; production builds default to https://widefleet.com.
# DOCS_WEBSITE_URL=http://localhost:5178
# Optional ingestion host override; defaults to the EU region.
# DOCS_POSTHOG_HOST=https://eu.i.posthog.com
