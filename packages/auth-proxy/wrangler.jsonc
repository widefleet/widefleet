{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "widefleet-auth-proxy",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "*.apps.example.com/*", "zone_name": "example.com" }],
  "kv_namespaces": [{ "binding": "AUTH_CONFIG", "id": "00000000000000000000000000000000" }],
  "services": [{ "binding": "APP_RUNTIME", "service": "widefleet-app-runtime" }],
}
