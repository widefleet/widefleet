# Keep the real file outside version control, mode 0600. Use an absolute directory.
# Run Compose from the repository root. See https://widefleet.com/docs/self-hosting/external-services for other selections.
COMPOSE_FILE=infra/compose.yaml
PLATFORM_DATA_DIRECTORY=/srv/app-platform
DOCKER_SOCKET_FILE=/var/run/docker.sock
PLATFORM_URL=https://platform.example.test
APP_DOMAIN=apps.example.test
# Optional with one enabled host; required when multiple hosts are enabled.
# Use hex passwords here so DATABASE_URL needs no additional percent-encoding.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
S3_ACCESS_KEY_ID=platform-storage
S3_SECRET_ACCESS_KEY=CHANGE_ME_RANDOM_HEX
# Company SSO, directory access and UI editability are configured in Settings.
# Authentication and encryption keys are generated in the persistent platform-state volume.
# Optionally provide a stable external encryption key (32 or more characters):
# PLATFORM_ENCRYPTION_KEY=...

# Fill in after registering the agent in management; do not invent a token.
PLATFORM_AGENT_TOKEN=

# Runtime logs: add infra/compose.telemetry.yaml to an explicit base/file selection.
# See https://widefleet.com/docs/self-hosting/runtime-logs for persistent directories and upgrading existing apps.
CLICKHOUSE_READ_PASSWORD=CHANGE_ME_RANDOM_HEX
CLICKHOUSE_INGEST_PASSWORD=CHANGE_ME_DIFFERENT_RANDOM_HEX

# External PostgreSQL: omit compose.postgres.yaml and supply a verified TLS URL.
# DATABASE_URL=postgres://widefleet:CHANGE_ME@database.example.com:5432/widefleet?sslmode=verify-full
# A private CA also needs compose.database-ca.yaml and sslrootcert=/run/secrets/postgres-ca.pem.
# DATABASE_CA_HOST_FILE=/absolute/secrets/postgres-ca.pem

# Azure Blob: select compose.base.yaml + compose.azure.yaml (no RustFS or S3 settings needed).
# AZURE_STORAGE_ACCOUNT_NAME=examplestorage
# AZURE_STORAGE_CONTAINER=widefleet-artifacts
# FLEET_AZURE_CONTAINER=widefleet-fleets
# Omit all credential variables for system-assigned managed identity.
# AZURE_CLIENT_ID=00000000-0000-4000-8000-000000000005
# Alternatively use an account key, without identity variables:
# AZURE_STORAGE_ACCESS_KEY=CHANGE_ME

# GCS: select compose.base.yaml + compose.gcs.yaml; default is attached VM identity.
# GCS_BUCKET=example-widefleet-artifacts
# FLEET_GCS_BUCKET=example-widefleet-fleets
# File credentials also need compose.storage-credential.yaml:
# GOOGLE_APPLICATION_CREDENTIALS=/run/widefleet/storage-credential
# FLEET_CREDENTIAL_HOST_FILE=/absolute/secrets/storage-credential.json

# Automatic HTTPS: add compose.acme-cloudflare.yaml to the explicit base/file selection.
# CLOUDFLARE_DNS_TOKEN_FILE=/absolute/secrets/cloudflare-dns-token
# ACME_EMAIL=operator@example.com
# ACME_ENVIRONMENT=staging
