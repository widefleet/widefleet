{
  "http": {
    "middlewares": {
      "app-auth": {
        "chain": {
          "middlewares": ["clear-client-identity", "company-sso", "remove-app-credentials"]
        }
      },
      "clear-client-identity": {
        "headers": {
          "customRequestHeaders": {
            "X-Auth-Request-User": "",
            "X-Auth-Request-Email": "",
            "X-Auth-Request-Preferred-Username": "",
            "X-Auth-Request-Groups": "",
            "X-Auth-Request-Access-Token": "",
            "X-Auth-Request-Redirect": "",
            "Authorization": ""
          }
        }
      },
      "company-sso": {
        "forwardAuth": {
          "address": "http://oauth2-proxy:4180/",
          "authRequestHeaders": ["Cookie", "User-Agent", "Accept"],
          "authResponseHeaders": [
            "X-Auth-Request-User",
            "X-Auth-Request-Email",
            "X-Auth-Request-Preferred-Username",
            "X-Auth-Request-Groups"
          ]
        }
      },
      "remove-app-credentials": {
        "headers": {
          "customRequestHeaders": {
            "Cookie": "",
            "Authorization": "",
            "X-Auth-Request-Access-Token": ""
          },
          "customResponseHeaders": {
            "Set-Cookie": ""
          }
        }
      }
    }
  }
}
