# Keep unrelated workspace source out of this image's COPY/cache inputs.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig*.json
!.npmrc
!.pnpmfile.cjs
!.gitignore
!.gitattributes
!LICENSE
!patches/**
!packages/**
!infra/runtime/licenses/**
!plugins/widefleet/skills/**
!apps/*/package.json
!starters/*/package.json
!templates/*/package.json
!examples/apps/*/package.json
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!.cargo/**
!crates/**

# Preserve the repository-wide exclusions after all inclusions.
.git
.local
.tools
node_modules
**/node_modules
**/.svelte-kit
**/.blume
**/.blume-verify
**/.wrangler
**/build
**/dist
target
**/.platform
**/tests
**/*.test.ts
**/.env
**/.env.*
**/test-results
**/playwright-report
